<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TetherKeeper.ViewModels"
             xmlns:res="clr-namespace:TetherKeeper.Resources.Strings"
             x:Class="TetherKeeper.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{x:Static res:AppStrings.Tab_Monitor}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <!-- 状態 -->
        <Border Grid.Row="0"
                Padding="16"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="10">
                    <Ellipse Fill="{Binding StatusColor}"
                             WidthRequest="14"
                             HeightRequest="14"
                             VerticalOptions="Center" />
                    <Label Text="{Binding StatusText}"
                           FontSize="20"
                           FontAttributes="Bold"
                           SemanticProperties.HeadingLevel="Level1" />
                </HorizontalStackLayout>
                <Label Text="{Binding ConfigurationText}" LineBreakMode="CharacterWrap" />
                <Label Text="{Binding NextRunText}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </Border>

        <!-- 操作 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,90" ColumnSpacing="8">
            <Button Text="{Binding ToggleButtonText}"
                    Command="{Binding ToggleCommand}" />
            <Button Grid.Column="1"
                    Text="{x:Static res:AppStrings.Main_RunNow}"
                    Command="{Binding RunNowCommand}" />
            <!-- 終了は主操作 (紫) や無効状態 (グレー) と区別するため薄い赤の塗りつぶし -->
            <Button Grid.Column="2"
                    Text="{x:Static res:AppStrings.Main_Exit}"
                    Command="{Binding ExitCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerContainer}, Dark={StaticResource DangerContainerDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource OnDangerContainerDark}}" />
        </Grid>

        <!-- 自動停止 -->
        <Border Grid.Row="2"
                Padding="12,8"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <VerticalStackLayout Spacing="4">
                <!-- Windows の TimePicker は最小幅が大きいため、ボタンは見出し行に置き、ピッカーは狭い幅で折り返す -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{x:Static res:AppStrings.Main_AutoStop}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="{Binding AutoStopButtonText}"
                            Padding="10,4"
                            MinimumHeightRequest="32"
                            Command="{Binding ToggleAutoStopCommand}" />
                </Grid>
                <FlexLayout Wrap="Wrap" AlignItems="Center">
                    <DatePicker Date="{Binding AutoStopDate}"
                                Format="yyyy/MM/dd"
                                IsEnabled="{Binding CanEditAutoStop}"
                                Margin="0,0,8,4" />
                    <TimePicker Time="{Binding AutoStopTime}"
                                Format="HH:mm"
                                IsEnabled="{Binding CanEditAutoStop}"
                                Margin="0,0,8,4" />
                    <!-- 今からの時間で予約する。予約済みのときは「解除」してから選び直す -->
                    <Button Text="{x:Static res:AppStrings.Main_InOneHour}"
                            Padding="10,4"
                            MinimumHeightRequest="32"
                            Margin="0,0,8,4"
                            IsVisible="{Binding CanEditAutoStop}"
                            Command="{Binding ScheduleAutoStopAfterCommand}"
                            CommandParameter="1"
                            ToolTipProperties.Text="{x:Static res:AppStrings.Main_InOneHourTip}" />
                    <Button Text="{x:Static res:AppStrings.Main_InTwoHours}"
                            Padding="10,4"
                            MinimumHeightRequest="32"
                            Margin="0,0,0,4"
                            IsVisible="{Binding CanEditAutoStop}"
                            Command="{Binding ScheduleAutoStopAfterCommand}"
                            CommandParameter="2"
                            ToolTipProperties.Text="{x:Static res:AppStrings.Main_InTwoHoursTip}" />
                </FlexLayout>
                <Label Text="{Binding AutoStopText}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding WeeklyStopText}"
                       IsVisible="{Binding IsWeeklyStopEnabled}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding AutoStopError}"
                       IsVisible="{Binding HasAutoStopError}"
                       FontSize="12"
                       TextColor="#E53935" />
            </VerticalStackLayout>
        </Border>

        <!-- 通信量 -->
        <Border Grid.Row="3"
                Padding="12,8"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="{x:Static res:AppStrings.Main_DataUsage}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding DataUsageText}" VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="{x:Static res:AppStrings.Main_Reset}"
                            Padding="10,4"
                            MinimumHeightRequest="32"
                            ToolTipProperties.Text="{x:Static res:AppStrings.Main_ResetTip}"
                            Command="{Binding ResetDataUsageCommand}" />
                </Grid>
                <Label Text="{Binding DataUsageNote}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label Text="{x:Static res:AppStrings.Main_DataLimitReached}"
                       IsVisible="{Binding IsDataLimitReached}"
                       FontSize="12"
                       TextColor="#E53935" />
            </VerticalStackLayout>
        </Border>

        <!-- 統計 -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="4">
            <Label Text="{x:Static res:AppStrings.Main_Total}" HorizontalOptions="Center" FontSize="12" />
            <Label Grid.Column="1" Text="{x:Static res:AppStrings.Main_Succeeded}" HorizontalOptions="Center" FontSize="12" />
            <Label Grid.Column="2" Text="{x:Static res:AppStrings.Main_Failed}" HorizontalOptions="Center" FontSize="12" />
            <Label Grid.Column="3" Text="{x:Static res:AppStrings.Main_ConsecutiveFailures}" HorizontalOptions="Center" FontSize="12" />
            <Label Grid.Row="1" Text="{Binding TotalCount}" HorizontalOptions="Center" FontSize="22" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SuccessCount}" HorizontalOptions="Center" FontSize="22" />
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding FailureCount}" HorizontalOptions="Center" FontSize="22" />
            <Label Grid.Row="1" Grid.Column="3" Text="{Binding ConsecutiveFailures}" HorizontalOptions="Center" FontSize="22" />
        </Grid>

        <VerticalStackLayout Grid.Row="5" Spacing="4">
            <Label Text="{Binding FallbackSuccessText}"
                   IsVisible="{Binding HasFallbackSuccess}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <Label Text="{Binding LastResultText}" LineBreakMode="TailTruncation" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Text="{x:Static res:AppStrings.Main_Log}" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="{x:Static res:AppStrings.Main_ResetStatistics}"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        Command="{Binding ResetStatisticsCommand}" />
                <Button Grid.Column="2"
                        Text="{x:Static res:AppStrings.Main_ClearLog}"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        ToolTipProperties.Text="{x:Static res:AppStrings.Main_ClearLogTip}"
                        Command="{Binding ClearLogCommand}" />
                <Button Grid.Column="3"
                        Text="{x:Static res:AppStrings.Main_Location}"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        ToolTipProperties.Text="{x:Static res:AppStrings.Main_LocationTip}"
                        Command="{Binding OpenLogFolderCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- ログ -->
        <Border Grid.Row="6"
                Padding="8"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <CollectionView ItemsSource="{Binding Logs}">
                <CollectionView.EmptyView>
                    <Label Text="{x:Static res:AppStrings.Main_NoLogs}" HorizontalOptions="Center" Margin="0,16" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLine">
                        <Label Text="{Binding Text}"
                               TextColor="{Binding TextColor}"
                               FontSize="12"
                               Padding="0,2"
                               LineBreakMode="CharacterWrap" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>

</ContentPage>
