<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TetherKeeper.ViewModels"
             xmlns:res="clr-namespace:TetherKeeper.Resources.Strings"
             xmlns:models="clr-namespace:KeepAlive.Core.Models;assembly=KeepAlive.Core"
             x:Class="TetherKeeper.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static res:AppStrings.Tab_Settings}">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Style>
        <!-- 「アプリの情報」のボタン。「保存」と区別するため、「既定値に戻す」と同じ控えめな色にする -->
        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4" MaximumWidthRequest="640">

            <Label Text="{x:Static res:AppStrings.Settings_Method}" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Methods}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:MethodOption}"
                    SelectedItem="{Binding SelectedMethod}" />
            <Label Text="{Binding MethodDescription}" Style="{StaticResource Hint}" />

            <Label Text="{x:Static res:AppStrings.Settings_Fallback}" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding FallbackOptions}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:FallbackOption}"
                    SelectedItem="{Binding SelectedFallback}" />
            <Label Text="{x:Static res:AppStrings.Settings_FallbackHint}"
                   Style="{StaticResource Hint}" />

            <VerticalStackLayout IsVisible="{Binding IsPing}" Spacing="4">
                <Label Text="{x:Static res:AppStrings.Settings_PingHost}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding PingHost}" Placeholder="1.1.1.1" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsHttpHead}" Spacing="4">
                <Label Text="{x:Static res:AppStrings.Settings_HttpUrl}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding HttpUrl}" Keyboard="Url" Placeholder="http://www.msftconnecttest.com/connecttest.txt" />
            </VerticalStackLayout>

            <!-- ホストとポートは横並びにして縦幅を抑える -->
            <Grid IsVisible="{Binding IsTcpConnect}"
                  ColumnDefinitions="*,110"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="4">
                <Label Text="{x:Static res:AppStrings.Settings_TcpHost}" Style="{StaticResource FieldLabel}" />
                <Label Grid.Column="1" Text="{x:Static res:AppStrings.Settings_Port}" Style="{StaticResource FieldLabel}" />
                <Entry Grid.Row="1" Text="{Binding TcpHost}" Placeholder="1.1.1.1" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding TcpPort}" Keyboard="Numeric" Placeholder="443" />
            </Grid>

            <!-- 実行間隔とタイムアウトも横並び -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="4">
                <Label Text="{x:Static res:AppStrings.Settings_Interval}" Style="{StaticResource FieldLabel}" />
                <Label Grid.Column="1" Text="{x:Static res:AppStrings.Settings_Timeout}" Style="{StaticResource FieldLabel}" />
                <Entry Grid.Row="1" Text="{Binding IntervalSeconds}" Keyboard="Numeric" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding TimeoutMilliseconds}" Keyboard="Numeric" />
            </Grid>
            <Label Text="{x:Static res:AppStrings.Settings_IntervalHint}"
                   Style="{StaticResource Hint}" />
            <!-- 通信方式と実行間隔から計算した、キープアライブ自身の通信量の目安 -->
            <VerticalStackLayout IsVisible="{Binding HasTrafficEstimate}" Spacing="0">
                <Label Text="{Binding TrafficEstimateText}" FontAttributes="Bold" FontSize="13" />
                <Label Text="{x:Static res:AppStrings.Settings_TrafficEstimateHint}"
                       Style="{StaticResource Hint}" />
            </VerticalStackLayout>

            <Label Text="{x:Static res:AppStrings.Settings_DataLimit}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding DataLimitMegabytes}" Keyboard="Numeric" Placeholder="0" />
            <Label Text="{x:Static res:AppStrings.Settings_DataLimitHint}"
                   Style="{StaticResource Hint}" />

            <!-- 毎週の自動停止 -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="{x:Static res:AppStrings.Settings_WeeklyStop}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding WeeklyStopEnabled}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding WeeklyStopEnabled}" Spacing="4">
                <FlexLayout Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding WeeklyStopDays}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:WeeklyDayOption">
                            <HorizontalStackLayout Margin="0,0,8,0">
                                <CheckBox IsChecked="{Binding IsSelected}" />
                                <Label Text="{Binding Name}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <TimePicker Time="{Binding WeeklyStopTime}" Format="HH:mm" HorizontalOptions="Start" />
                <Label Text="{x:Static res:AppStrings.Settings_WeeklyStopHint}"
                       Style="{StaticResource Hint}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:AppStrings.Settings_ExitOnAutoStop}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ExitAppOnAutoStop}" />
            </Grid>
            <Label Text="{x:Static res:AppStrings.Settings_ExitOnAutoStopHint}"
                   Style="{StaticResource Hint}" />

            <!-- 通信の失敗の通知 -->
            <Label Text="{x:Static res:AppStrings.Settings_FailureThreshold}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding FailureThreshold}" Keyboard="Numeric" Placeholder="3" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:AppStrings.Settings_NotifyOnFailure}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnFailure}" />
            </Grid>
            <Label Text="{x:Static res:AppStrings.Settings_NotifyHint}"
                   Style="{StaticResource Hint}" />

            <!-- 動作中のスリープ抑止 -->
            <VerticalStackLayout IsVisible="{Binding IsSleepPreventionSupported}" Spacing="4" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static res:AppStrings.Settings_PreventSleep}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding PreventSleepWhileRunning}" />
                </Grid>
                <Label Text="{x:Static res:AppStrings.Settings_PreventSleepHint}"
                       Style="{StaticResource Hint}" />
            </VerticalStackLayout>

            <!-- ネットワークに応じた自動開始・停止 -->
            <VerticalStackLayout IsVisible="{Binding IsNetworkAutoControlSupported}" Spacing="4" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static res:AppStrings.Settings_AutoControl}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoControlByNetwork}" />
                </Grid>
                <VerticalStackLayout IsVisible="{Binding AutoControlByNetwork}" Spacing="4">
                    <Label Text="{x:Static res:AppStrings.Settings_NetworkName}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding AutoControlNetworkName}" Placeholder="{x:Static res:AppStrings.Settings_NetworkNamePlaceholder}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker Title="{x:Static res:AppStrings.Settings_ChooseNetwork}"
                                ItemsSource="{Binding ConnectedNetworks}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=models:ConnectedNetwork}"
                                SelectedItem="{Binding SelectedConnectedNetwork}" />
                        <Button Grid.Column="1"
                                Text="{x:Static res:AppStrings.Common_Refresh}"
                                Command="{Binding RefreshNetworksCommand}"
                                Style="{StaticResource InfoButton}"
                                ToolTipProperties.Text="{x:Static res:AppStrings.Settings_RefreshNetworksTip}" />
                    </Grid>
                    <Label Text="{x:Static res:AppStrings.Settings_NetworkHint}"
                           Style="{StaticResource Hint}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="{x:Static res:AppStrings.Settings_StartOnLaunch}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding StartOnLaunch}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsAutoStartSupported}">
                <Label Text="{x:Static res:AppStrings.Settings_LaunchAtLogin}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding LaunchAtLogin}" />
            </Grid>

            <Label Text="{Binding ErrorText}"
                   IsVisible="{Binding HasErrors}"
                   TextColor="#E53935"
                   Margin="0,12,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Text="{x:Static res:AppStrings.Settings_Save}" Command="{Binding SaveCommand}" />
                <Button Grid.Column="1"
                        Text="{x:Static res:AppStrings.Settings_RestoreDefaults}"
                        Command="{Binding RestoreDefaultsCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </Grid>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource Hint}" HorizontalOptions="Center" />

            <Label Text="{x:Static res:AppStrings.Settings_Disclaimer}"
                   Style="{StaticResource Hint}"
                   Margin="0,12,0,0" />

            <!-- アプリの情報 -->
            <Label Text="{x:Static res:AppStrings.Settings_AppInfo}" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
            <Button Text="{x:Static res:AppStrings.Settings_About}"
                    Style="{StaticResource InfoButton}"
                    Clicked="OnAboutButtonClick"
                    ToolTipProperties.Text="{x:Static res:AppStrings.Settings_AboutTip}" />
            <Button Text="{x:Static res:AppStrings.Settings_Licenses}"
                    Style="{StaticResource InfoButton}"
                    Clicked="OnThirdPartyNoticesButtonClick"
                    ToolTipProperties.Text="{x:Static res:AppStrings.Settings_LicensesTip}" />
            <Button Text="{x:Static res:AppStrings.Settings_UserGuide}"
                    Style="{StaticResource InfoButton}"
                    Clicked="OnUserGuideButtonClick"
                    ToolTipProperties.Text="{x:Static res:AppStrings.Settings_UserGuideTip}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
