<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TetherKeeper.ViewModels"
             xmlns:res="clr-namespace:TetherKeeper.Resources.Strings"
             x:Class="TetherKeeper.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{x:Static res:AppStrings.Tab_History}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8" MaximumWidthRequest="640">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Picker ItemsSource="{Binding Periods}"
                        ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:HistoryPeriod}"
                        SelectedItem="{Binding SelectedPeriod}" />
                <Button Grid.Column="1"
                        Text="{x:Static res:AppStrings.Common_Refresh}"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        Command="{Binding ReloadCommand}" />
                <Button Grid.Column="2"
                        Text="{x:Static res:AppStrings.History_Export}"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        Command="{Binding ExportCommand}"
                        ToolTipProperties.Text="{x:Static res:AppStrings.History_ExportTip}" />
            </Grid>

            <Label Text="{Binding SummaryText}" FontAttributes="Bold" />
            <Label Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}"
                   FontSize="12"
                   LineBreakMode="CharacterWrap"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <!-- 時間帯ごとの失敗。棒は失敗率 (最も高い時間帯を最大の長さにする) -->
            <Label Text="{x:Static res:AppStrings.History_ByHour}" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HourRows}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HourRow">
                        <Grid ColumnDefinitions="48,170,*" ColumnSpacing="8">
                            <Label Text="{Binding HourText}" FontSize="12" VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="#E53935"
                                     HeightRequest="10"
                                     WidthRequest="{Binding BarWidth}"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     IsVisible="{Binding HasFailures}" />
                            <Label Grid.Column="2" Text="{Binding CountText}" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{x:Static res:AppStrings.History_Note}"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
