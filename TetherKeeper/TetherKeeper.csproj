<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>TetherKeeper</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>TetherKeeper</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.tetherkeeper</ApplicationId>

		<!-- Versions
		     exe 版とストア版のバージョンは、ApplicationDisplayVersion の 1 か所で決める。
		     Windows では、ApplicationDisplayVersion が exe のバージョン (1.0.0 → 1.0.0.0) になり、
		     「ApplicationDisplayVersion.ApplicationVersion」が MSIX のバージョン (1.0.0.0) になる。
		     ストアに提出するパッケージは 4 つ目の数字を 0 にする必要があるため、ApplicationVersion は 0 のままにし、
		     リリースのときは ApplicationDisplayVersion を上げる (docs/BuildGuide.md の「バージョンの上げ方」を参照) -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>0</ApplicationVersion>

		<!-- 「このアプリについて」に表示する著作権表記 -->
		<Copyright>© 2026 SystemAzmax</Copyright>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- MSIX の既定の言語。パッケージに無い言語 (日本語・英語以外) では、この言語のリソースが使われる。
		     アプリ名を日本語以外では英語名にするため en-US にする (Platforms\Windows\Strings を参照) -->
		<DefaultLanguage Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">en-US</DefaultLanguage>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<!-- 「ライセンス情報」で開く、使用しているソフトウェアのライセンス表示。
		     パッケージを更新したときの作り直し方は docs/BuildGuide.md を参照 -->
		<Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B7FBF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B7FBF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- 画面・ログ・通知の文言。AppStrings.resx が英語 (既定)、AppStrings.ja.resx が日本語。
	     Windows の表示言語が日本語なら日本語、それ以外は英語になる。ビルド時に AppStrings クラスを生成する
	     (Core 側の文言は KeepAlive.Core の CoreStrings) -->
	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings\AppStrings.resx">
			<StronglyTypedFileName>$(IntermediateOutputPath)AppStrings.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>TetherKeeper.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppStrings</StronglyTypedClassName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
		<Using Include="TetherKeeper.Resources.Strings" />
		<Using Include="KeepAlive.Core.Resources" />
	</ItemGroup>

	<!-- WinUI の XAML コンパイラーは、通常のコンパイルより前に一度ソースをコンパイルする。
	     そのときに AppStrings クラスができているよう、リソースの生成を先に行う。
	     リソース名を決める PrepareResourceNames を先に行わないと、リソース名が空 (.resources) になり、実行時に文言を読めない -->
	<Target Name="GenerateResourcesBeforeXamlCompile"
	        BeforeTargets="MarkupCompilePass1"
	        DependsOnTargets="PrepareResourceNames;ResGen" />

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\KeepAlive.Core\KeepAlive.Core.csproj" />
	  <ProjectReference Include="..\KeepAlive.Infrastructure\KeepAlive.Infrastructure.csproj" />
	</ItemGroup>

	<!-- MAUI が Package.appxmanifest を作るターゲット (MauiGeneratePackageAppxManifest) は、入力に csproj を含まない。
	     そのため ApplicationDisplayVersion などを変えても、前回作ったマニフェストの古いバージョンのまま MSIX ができてしまう。
	     バージョンが前回と違うときは、そのターゲットの出力の目印 (stamp) を消して、マニフェストを作り直させる -->
	<Target Name="RegenerateAppxManifestWhenVersionChanges"
	        BeforeTargets="MauiGeneratePackageAppxManifest"
	        Condition="'$(_ResizetizerIsWindowsAppSdk)' == 'True'">
		<PropertyGroup>
			<_AppVersionStampFile>$(IntermediateOutputPath)appversion.stamp</_AppVersionStampFile>
			<_AppVersionText>$(ApplicationDisplayVersion).$(ApplicationVersion)</_AppVersionText>
			<_PreviousAppVersionText Condition="Exists('$(_AppVersionStampFile)')">$([System.IO.File]::ReadAllText('$(_AppVersionStampFile)').Trim())</_PreviousAppVersionText>
		</PropertyGroup>
		<Delete Files="$(_MauiManifestStampFile)" Condition="'$(_AppVersionText)' != '$(_PreviousAppVersionText)'" />
		<WriteLinesToFile File="$(_AppVersionStampFile)" Lines="$(_AppVersionText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
	</Target>

</Project>
