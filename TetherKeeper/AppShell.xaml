<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TetherKeeper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TetherKeeper.Views"
    xmlns:res="clr-namespace:TetherKeeper.Resources.Strings">

    <TabBar>
        <ShellContent
            Title="{x:Static res:AppStrings.Tab_Monitor}"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="{x:Static res:AppStrings.Tab_History}"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="HistoryPage" />
        <ShellContent
            Title="{x:Static res:AppStrings.Tab_Settings}"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
